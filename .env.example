# Postgres. Local: docker compose provides this. AWS: RDS in ap-southeast-2.
DATABASE_URL="postgresql://mymob:mymob@localhost:5433/mymob?schema=public"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-32+-random-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded demo numbers (+61 400 000 0xx) accept this OTP. Leave empty in production.
DEMO_OTP_CODE="123456"

# Shared secret for POST /api/cron/reminders
CRON_SECRET="dev-cron"
APP_TIMEZONE="Australia/Darwin"

# --- AWS SNS (SMS). Unset/false = mock: messages go to the /admin/outbox panel. ---
SNS_ENABLED="false"
AWS_REGION="ap-southeast-2"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# SNS_SENDER_ID="MyMob"

# --- AI Aunty (Amazon Bedrock). Unset = mock: she replies from canned lines. ---
# Use a Sydney inference profile so members' words stay in ap-southeast-2, and
# enable model access for it first (AWS console > Bedrock > Model access).
# Newer models reject the bare model ID; the profile ID is that ID with the
# region prefix, e.g. "apac.". List yours with:
#   aws bedrock list-inference-profiles --region ap-southeast-2
# BEDROCK_MODEL_ID="apac.anthropic.claude-sonnet-4-5-20250929-v1:0"
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY above, or the task role in ECS). Region: AWS_REGION.

# --- APNs (push). Any unset = mock: pushes are logged to the outbox. ---
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID=""
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRODUCTION="false"
