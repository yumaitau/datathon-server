# Postgres. Local: docker compose provides this. AWS: RDS in ap-southeast-2.
DATABASE_URL="postgresql://mymob:mymob@localhost:5433/mymob?schema=public"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-32+-random-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded demo numbers (+61 400 000 0xx) accept this OTP. Leave empty in production.
DEMO_OTP_CODE="123456"

# Shared secret for POST /api/cron/reminders
CRON_SECRET="dev-cron"
APP_TIMEZONE="Australia/Darwin"

# --- AWS SNS (SMS). Unset/false = mock: messages go to the /admin/outbox panel. ---
SNS_ENABLED="false"
AWS_REGION="ap-southeast-2"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# SNS_SENDER_ID="MyMob"

# --- APNs (push). Any unset = mock: pushes are logged to the outbox. ---
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID=""
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRODUCTION="false"
