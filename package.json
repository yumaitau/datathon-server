{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-map-worker.mjs",
    "dev": "next dev",
    "build": "pnpm cf:build",
    "build:next": "node scripts/copy-map-worker.mjs && pnpm cf:schema && DATABASE_PROVIDER=d1 next build",
    "build:node": "node scripts/copy-map-worker.mjs && pnpm cf:schema && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:d1:migrate": "wrangler d1 migrations apply mymob-db --remote",
    "db:d1:migrate:local": "wrangler d1 migrations apply mymob-db --local",
    "cf:schema": "DATABASE_URL=postgresql://build:build@localhost:5432/build prisma generate && node scripts/generate-d1-schema.mjs && DATABASE_URL=file:./local.db prisma generate --schema prisma/schema.d1.prisma",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts",
    "cf:build": "DATABASE_PROVIDER=d1 opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "smoke": "python3 scripts/smoke.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1160.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@opennextjs/cloudflare": "1.20.15",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@11.11.0"
}
